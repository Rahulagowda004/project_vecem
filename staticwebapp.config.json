{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*", "/js/*", "/api/*"]
  },
  "routes": [
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/login",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/signup",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/auth/action",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "methods": ["GET"],
      "rewrite": "/index.html",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
    "cache-control": "no-cache"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "apiRoutes": {
    "timeout": "30s",
    "retry": {
      "maxRetries": 3,
      "delay": "1s"
    }
  }
}
